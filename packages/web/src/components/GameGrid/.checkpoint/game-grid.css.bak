#game-grid {
  min-height: 100px;
  margin-top: 20px;
}

/* === TEAM COLOR THEME === */
/* Team A = Blue (#2185d0) | Team B = Emerald Green (#27ae60) */

.teamACards,
.teamBCards {
  border-top: none;
  padding-top: 0 !important;
  border-radius: 0;
}

.card-container {
  height: 100%;
}

.flip_image {
  z-index: -1;
}

.normal_image {
  z-index: 1;
}

.btn-group {
  display: flex;
  justify-content: space-evenly;
}

.btn-group button {
  background-color: #4caf50;
  /* Green background */
  border: 1px solid green;
  /* Green border */
  color: white;
  /* White text */
  padding: 10px 24px;
  /* Some padding */
  cursor: pointer;
  /* Pointer/hand icon */
  float: left;
  /* Float the buttons side by side */
}

/* Clear floats (clearfix hack) */
.btn-group:after {
  content: "";
  clear: both;
  display: table;
}

.btn-group button:not(:last-child) {
  border-right: none;
  /* Prevent double borders */
}

/* Add a background color on hover */
.btn-group button:hover {
  background-color: #3e8e41;
}

.container {
  display: block;
  position: relative;
  padding-left: 35px;
  margin-bottom: 12px;
  /* font-size: 22px; */
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

/* Hide the browser's default radio button */
.container input {
  position: absolute;
  opacity: 0;
}

/* Create a custom radio button */
.checkmark {
  position: absolute;
  top: 0;
  left: 0;
  height: 25px;
  width: 25px;
  background-color: #eee;
  border-radius: 50%;
  cursor: pointer;
}

/* On mouse-over, add a grey background color */
.container:hover input~.checkmark {
  background-color: #ccc;
}

/* When the radio button is checked, add a blue background */
.container input:checked~.checkmark {
  background-color: #2196f3;
}

/* Create the indicator (the dot/circle - hidden when not checked) */
.checkmark:after {
  content: "";
  position: absolute;
  display: none;
}

/* Show the indicator (dot/circle) when checked */
.container input:checked~.checkmark:after {
  display: block;
}

/* Style the indicator (dot/circle) */
.container .checkmark:after {
  top: 9px;
  left: 9px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: white;
}

.disabled {
  pointer-events: none;
}

.plusminusButtons {
  font-size: 0.75rem !important;
}

.bidInProgress {
  background: initial;
}

.bidFinal {
  background: indianred !important;
}

.cardHeight {
  min-height: 13rem;
  margin-bottom: 1rem;
}

.clearButton {
  font-size: 0.75rem !important;
  background: #2185d0 !important;
}

.ui.inverted.dimmer {
  background-color: rgba(8, 10, 14, 0.62) !important;
  font-family: cursive;
}

@media only screen and (max-width: 480px) {
  .ui.inverted.dimmer {
    font-size: x-small;
    left: 25%;
    font-size: x-small;
  }
}

.marginBottom2 {
  margin-bottom: 2rem;
}

.scoreContainer {
  display: flex;
  justify-content: space-evenly;
}

.scoringLabel {
  width: auto;
}

/* The slider itself */
.slider {
  -webkit-appearance: none;
  /* Override default CSS styles */
  appearance: none;
  width: 60%;
  /* Full-width */
  height: 25px;
  /* Specified height */
  background: #bababc;
  /* Grey background */
  border-radius: 5px;
  outline: none;
  /* Remove outline */
  opacity: 1 !important;
  /* Set transparency (for mouse-over effects on hover) */
  -webkit-transition: 0.2s;
  /* 0.2 seconds transition on hover */
  transition: opacity 0.2s;
  position: relative !important;
}

/* The slider handle (use -webkit- (Chrome, Opera, Safari, Edge) and -moz- (Firefox) to override default look) */
.slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  /* Override default look */
  appearance: none;
  width: 25px;
  /* Set a specific slider handle width */
  height: 25px;
  /* Slider handle height */
  background: #5f5d5d;
  /* Green background */
  border-radius: 50%;
  cursor: pointer;
  /* Cursor on hover */
}

.slider::-moz-range-thumb {
  width: 25px;
  /* Set a specific slider handle width */
  height: 25px;
  /* Slider handle height */
  background: #4caf50;
  /* Green background */
  cursor: pointer;
  /* Cursor on hover */
}

.cardTable {
  background: url("./cardTable8.png") no-repeat;
  height: 25rem;
  background-position: center;
  background-size: 60rem;

  /* Laptops/Small Desktops (769px to 1024px) */
  @media screen and (max-width: 1024px) {
    background-size: 56rem;
  }

  /* Standard Tablets (Portrait, 600px to 768px) */
  @media screen and (max-width: 768px) {
    background-size: 42rem;
    height: 20rem;
  }

  /* Small Tablets / Large Phones (481px to 599px) */
  @media screen and (max-width: 599px) {
    background-size: 36rem;
    height: 16rem;
  }

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    background-size: 30rem;
    height: 15rem;
  }
}

.cardOnTable {
  display: flex;
  justify-content: center;
  padding-top: 8rem;

  /* Laptops/Small Desktops (769px to 1024px) */
  @media screen and (max-width: 1024px) {
    padding-top: 8rem;
  }

  /* Standard Tablets (Portrait, 600px to 768px) */
  @media screen and (max-width: 768px) {
    padding-top: 6.5rem;
  }

  /* Small Tablets / Large Phones (481px to 599px) */
  @media screen and (max-width: 599px) {
    padding-top: 4.5rem;
  }

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    padding-top: 4.75rem;
  }
}

.myCards {
  display: flex;
  justify-content: center;
  margin: -2.5rem 0 3rem;
  flex-wrap: wrap;
}

.biddingGrid {
  margin-top: 1rem;
}

.scoreSlider {
  opacity: 1 !important;
  top: 100%;
  transform: rotate(360deg);
  width: 11%;
}

.hideSlider {
  display: none;
}

.showSlider {
  display: inline;
  cursor: pointer;
}

