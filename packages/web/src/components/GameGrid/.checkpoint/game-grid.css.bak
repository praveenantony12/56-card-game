.teamAButtonGroup {
  padding-left: 1rem !important;

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    display: inline-block !important;
    padding-left: .25rem !important;
    font-size: 0.75rem !important;
  }
}

.teamBButtonGroup {
  padding-right: 1rem !important;

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    display: inline-block !important;
    padding-right: .25rem !important;
    font-size: 0.75rem !important;
  }
}

.handleBiddingPass {
  padding-top: 3rem;

  @media screen and (max-width: 768px) {
    padding-top: 2.5rem;
  }

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    padding-top: 1.5rem;
  }
}

.handleBiddingPassPostRaise {
  padding-top: 2.5rem;

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    padding-top: 1.5rem;
    padding: 10px;
    border-radius: 5px;
  }
}

.raiseYourBidContainer {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -170%);
  background-color: rgba(0, 0, 0, 0.85);
  color: white;
  padding: 16px;
  border-radius: 15px;
  text-align: center;
  z-index: 1000;
  min-width: 400px;

  @media screen and (max-width: 906px) {
    transform: translate(-50%, -230%);
  }

  @media screen and (max-width: 856px) {
    min-width: 500px;
  }

  @media screen and (max-width: 840px) {
    transform: translate(-50%, -230%);
    padding: 12px;
    border-radius: 10px;
    min-width: 440px;
  }

  @media screen and (max-width: 768px) {
    transform: translate(-50%, -110%);
    padding: 12px;
    border-radius: 10px;
    min-width: 400px;
  }
}

.showCursor {
  cursor: pointer;
}

.round-timer {
  position: absolute;
  top: 20%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 1.75rem;
  font-weight: bold;
  padding: .75rem;
  border-radius: 10px;
  z-index: 1000;
  white-space: nowrap;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  animation: pulse 1s infinite;
  background: #db2728;

  /* Standard Tablets (Portrait, 600px to 768px) */
  @media screen and (max-width: 768px) {
    top: 23%;
    margin-top: 0;
    font-size: 1.5rem;
    padding: .5rem;
    border-radius: 5px;
  }

  /* Small Tablets / Large Phones (481px to 599px) */
  @media screen and (max-width: 599px) {
    top: 17%;
    margin-top: 0;
    font-size: 1rem;
    padding: 0.35rem;
    border-radius: 6px;
  }

  /* Mobile only (0 to 480px) */
  @media screen and (max-width: 480px) {
    top: 20%;
    font-size: 1.25rem;
    padding: 0.35rem;
    border-radius: 5px;
  }
}

@keyframes pulse {
  0% {
    transform: translate(-50%, -50%) scale(1);
  }

  50% {
    transform: translate(-50%, -50%) scale(1.05);
  }

  100% {
    transform: translate(-50%, -50%) scale(1);
  }
}

.cardOnTable {
  position: relative;
}

.pass-button {
  /* position: absolute;
  right: 15%;
  top: 50%; */
  transform: translateY(-50%);
  /* padding: 12px 16px !important; */
  /* min-width: 50px !important; */
  color: #db2728 !important;
  border-color: #ca0a0a !important;
  transition: all 0.3s ease;
  cursor: pointer
    /* border-radius: 8px; */
    /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); */
}

.pass-button:hover {
  color: #ff1e1e !important;
  /* box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3); */
  transform: translateY(-50%) scale(1.1);
}

.pass-button.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.game-winner-message {

  /* Small Tablets / Large Phones (481px to 599px) */
  @media screen and (max-width: 599px) {
    top: 10%;
    font-size: 15px;
    max-width: 800px;
  }
}